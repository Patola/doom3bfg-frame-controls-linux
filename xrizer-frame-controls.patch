+// Fully Possessed polls legacy controller state. It reads trackpad axes for PDA
+// navigation and recognizes raw button bits 8-15 as additional bindable keys.
+struct DoomFrameActions {
+    buttons: [xr::Action<bool>; Self::BINDINGS.len()],
+    equip_state: Option<File>,
+    last_equip: AtomicBool,
+}
+
+impl DoomFrameActions {
+    const BINDINGS: [(&str, &str, &str); 10] = [
+        ("dpad-up", "/user/hand/left/input/dpad_up/click", ""),
+        ("dpad-down", "/user/hand/left/input/dpad_down/click", ""),
+        ("dpad-left", "/user/hand/left/input/dpad_left/click", ""),
+        ("dpad-right", "/user/hand/left/input/dpad_right/click", ""),
+        (
+            "bumper",
+            "/user/hand/left/input/bumper/click",
+            "/user/hand/right/input/bumper/click",
+        ),
+        (
+            "overlay-modifier",
+            "/user/hand/left/input/view/click",
+            "/user/hand/right/input/menu/click",
+        ),
+        (
+            "frame-stick-click",
+            "/user/hand/left/input/thumbstick/click",
+            "/user/hand/right/input/thumbstick/click",
+        ),
+        ("frame-b", "", "/user/hand/right/input/b/click"),
+        ("frame-x", "", "/user/hand/right/input/x/click"),
+        ("frame-y", "", "/user/hand/right/input/y/click"),
+    ];
+
+    fn new(set: &xr::ActionSet, subactions: &[xr::Path; 2]) -> Self {
+        Self {
+            buttons: Self::BINDINGS
+                .map(|(name, _, _)| set.create_action(name, name, subactions).unwrap()),
+            equip_state: std::env::var_os("XRIZER_DOOM3_FRAME_EQUIP")
+                .and_then(|path| OpenOptions::new().write(true).open(path).ok()),
+            last_equip: AtomicBool::new(false),
+        }
+    }
+
+    fn add_bindings<'a>(&'a self, instance: &xr::Instance, bindings: &mut Vec<xr::Binding<'a>>) {
+        for (button, (_, left, right)) in self.buttons.iter().zip(Self::BINDINGS) {
+            for path in [left, right].into_iter().filter(|path| !path.is_empty()) {
+                bindings.push(xr::Binding::new(
+                    button,
+                    instance.string_to_path(path).unwrap(),
+                ));
+            }
+        }
+    }
+
+    fn apply(
+        &self,
+        session: &xr::Session<xr::AnyGraphics>,
+        path: xr::Path,
+        hand: Hand,
+        state: &mut vr::VRControllerState_t,
+    ) {
+        let [
+            up,
+            down,
+            left,
+            right,
+            bumper,
+            overlay_modifier,
+            stick_click,
+            b,
+            x,
+            y,
+        ] = self.buttons.each_ref().map(|button| {
+            button
+                .state(session, path)
+                .is_ok_and(|value| value.is_active && value.current_state)
+        });
+        if hand == Hand::Left {
+            state.rAxis[3] = vr::VRControllerAxis_t {
+                x: (right as i32 - left as i32) as f32,
+                y: (up as i32 - down as i32) as f32,
+            };
+        }
+        // The mod's PDA treats legacy menu click as the previous tab and pad
+        // click as the next tab. View/Menu + Bumper remains available to WayVR.
+        if bumper && !overlay_modifier {
+            let id = match hand {
+                Hand::Left => vr::EVRButtonId::ApplicationMenu,
+                Hand::Right => vr::EVRButtonId::Axis0,
+            };
+            state.ulButtonPressed |= button_mask_from_id(id);
+        }
+        match hand {
+            Hand::Left => state.ulButtonPressed |= (stick_click as u64) << 8,
+            Hand::Right => {
+                state.ulButtonPressed |= (b as u64) << 8;
+                if !self.publish_equip(x) {
+                    state.ulButtonPressed |= (x as u64) << 9;
+                }
+                state.ulButtonPressed |= (y as u64) << 10;
+                state.ulButtonPressed |= (stick_click as u64) << 11;
+            }
+        }
+    }
+
+    fn publish_equip(&self, pressed: bool) -> bool {
+        let Some(file) = &self.equip_state else {
+            return false;
+        };
+        if self.last_equip.load(Ordering::Relaxed) != pressed {
+            if !matches!(file.write_at(&[u8::from(pressed)], 0), Ok(1)) {
+                return false;
+            }
+            self.last_equip.store(pressed, Ordering::Relaxed);
+        }
+        true
+    }
+}
+
+impl Drop for DoomFrameActions {
+    fn drop(&mut self) {
+        let _ = self.publish_equip(false);
+    }
+}
