+        let data = f.input.openxr.session_data.get();
+        let left = f.input.get_subaction_path(Hand::Left);
+        let right = f.input.get_subaction_path(Hand::Right);
+        let legacy = super::LegacyActionData::new(instance, left, right, true);
+        let frame = legacy.frame.as_ref().unwrap();
+        let mut bindings = Vec::new();
+        frame.add_bindings(instance, &mut bindings);
+        let profile = instance
+            .string_to_path(FrameController::profile_path())
+            .unwrap();
+        instance
+            .suggest_interaction_profile_bindings(profile, &bindings)
+            .unwrap();
+        data.session.attach_action_sets(&[&legacy.set]).unwrap();
+
+        let [up, _, _, dpad_right, bumper, modifier, stick, b, x, y] = &frame.buttons;
+        assert_eq!(
+            fakexr::get_suggested_bindings(up.as_raw(), profile),
+            ["/user/hand/left/input/dpad_up/click"],
+        );
+        for action in [up, dpad_right, bumper, modifier] {
+            fakexr::set_action_state(action.as_raw(), true.into(), LeftHand);
+        }
+        for action in [bumper, stick, b, x, y] {
+            fakexr::set_action_state(action.as_raw(), true.into(), RightHand);
+        }
+        let sync = || {
+            data.session
+                .sync_actions(&[xr::ActiveActionSet::new(&legacy.set)])
+                .unwrap()
+        };
+        sync();
+
+        let mut state = vr::VRControllerState_t::default();
+        state.rAxis[0].x = 0.25;
+        frame.apply(&data.session, left, Hand::Left, &mut state);
+        assert_eq!(state.rAxis[0].x, 0.25);
+        assert_eq!((state.rAxis[3].x, state.rAxis[3].y), (1.0, 1.0));
+        let left_tab = super::button_mask_from_id(vr::EVRButtonId::ApplicationMenu);
+        let right_tab = super::button_mask_from_id(vr::EVRButtonId::Axis0);
+        assert_eq!(state.ulButtonPressed & left_tab, 0);
+
+        fakexr::set_action_state(modifier.as_raw(), false.into(), LeftHand);
