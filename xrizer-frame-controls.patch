@@ -0,0 +1,94 @@
+use super::{
+    InputToXrPath, InteractionProfile, MainAxisType, ProfileProperties, Property,
+    SkeletalInputBindings, legal_paths, oculus_touch::OculusTouch, paths::*,
+};
+use crate::input::legacy::{self, LegacyBindings};
+use crate::openxr_data::Hand;
+use glam::Mat4;
+use openxr as xr;
+
+pub(crate) const EXTENSION: &[u8] = b"XR_VALVE_frame_controller_interaction\0";
+
+pub(crate) struct FrameController;
+
+impl InteractionProfile for FrameController {
+    type LegalPaths = legal_paths![
+        Both::<
+            (Squeeze, Value),
+            (Trigger, Value),
+            (Trigger, Touch),
+            (Thumbstick, ()),
+            (Thumbstick, Click),
+            (Thumbstick, Touch),
+        >,
+        Right::<(A, Click), (A, Touch), (B, Click), (B, Touch)>
+    ];
+
+    fn profile_path() -> &'static str {
+        "/interaction_profiles/valve/frame_controller_valve"
+    }
+
+    fn has_required_extensions(extensions: &xr::ExtensionSet) -> bool {
+        extensions.other.iter().any(|name| name == EXTENSION)
+    }
+
+    fn properties() -> &'static ProfileProperties {
+        static PROPERTIES: ProfileProperties = ProfileProperties {
+            model: Property::PerHand {
+                left: c"Steam Frame Controller (Left)",
+                right: c"Steam Frame Controller (Right)",
+            },
+            openvr_controller_type: c"frame_controller",
+            render_model_name: Property::PerHand {
+                left: c"oculus_quest2_controller_left",
+                right: c"oculus_quest2_controller_right",
+            },
+            registered_device_type: Property::PerHand {
+                left: c"frame/controller_left",
+                right: c"frame/controller_right",
+            },
+            serial_number: Property::PerHand {
+                left: c"XRizer_Frame_Left",
+                right: c"XRizer_Frame_Right",
+            },
+            tracking_system_name: c"frame",
+            manufacturer_name: c"Valve",
+            main_axis: MainAxisType::Thumbstick,
+            // Menu, grip, A, thumbstick, trigger, squeeze, the Doom extra buttons.
+            legacy_buttons_mask: (1 << 1) | (1 << 2) | (1 << 7) | (0x0f << 8) | (7 << 32),
+        };
+        &PROPERTIES
+    }
+
+    fn legacy_bindings(c: &InputToXrPath<Self>) -> LegacyBindings {
+        LegacyBindings {
+            extra: legacy::Bindings {
+                grip_pose: c.pose(),
+            },
+            trigger: c.leftright::<Trigger, Value, _, _>(),
+            trigger_click: c.leftright::<Trigger, Value, _, _>(),
+            app_menu: Vec::new(),
+            a: c.into::<super::Right<A, Click>, _>(),
+            squeeze_click: c.leftright::<Squeeze, Value, _, _>(),
+            squeeze: c.leftright::<Squeeze, Value, _, _>(),
+            main_xy: c.leftright::<Thumbstick, (), _, _>(),
+            main_xy_click: Vec::new(),
+            main_xy_touch: c.leftright::<Thumbstick, Touch, _, _>(),
+            haptic: c.haptics(),
+        }
+    }
+
+    fn skeletal_input_bindings(c: &InputToXrPath<Self>) -> SkeletalInputBindings {
+        SkeletalInputBindings {
+            thumb_touch: c.leftright::<Thumbstick, Touch, _, _>(),
+            index_touch: c.leftright::<Trigger, Touch, _, _>(),
+            index_curl: c.leftright::<Trigger, Value, _, _>(),
+            rest_curl: c.leftright::<Squeeze, Value, _, _>(),
+        }
+    }
+
+    fn offset_grip_pose(hand: Hand) -> Mat4 {
+        // Preserve the grip alignment used by the Touch fallback in this game.
+        OculusTouch::offset_grip_pose(hand)
+    }
+}
